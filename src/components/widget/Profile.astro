---
import { Icon } from 'astro-icon/components';
import { profileConfig } from '../../config';
import { url } from '../../utils/url-utils';
import ImageWrapper from '../misc/ImageWrapper.astro';
---
<aside class="card-base personal-profile" aria-label="著者プロフィール">
  <a href={url('/about/')} class="profile-avatar" aria-label="田中貴士のプロフィールを見る">
    <ImageWrapper src={profileConfig.avatar || ''} alt="田中貴士のGitHubプロフィール画像" class="w-full h-full" />
  </a>
  <p class="profile-name">{profileConfig.name}</p>
  <p class="profile-handle">@tanakaisworking</p>
  <p class="profile-bio">{profileConfig.bio}</p>
  <div class="flex gap-2 justify-center">
    {profileConfig.links.map(item => <a href={item.url} target="_blank" rel="me noopener noreferrer" aria-label={`${item.name}（新しいタブ）`} class="btn-regular rounded-lg h-10 w-10"><Icon name={item.icon} class="text-xl" /></a>)}
  </div>
</aside>
