---
import { projects } from '../data/projects';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['project-grid', { compact }]}>
  {projects.map((project, index) => (
    <article id={project.id} class="card-base project-card">
      <div class="project-topline"><span class="project-number" aria-hidden="true">0{index + 1}</span><span class="project-label">{project.label}</span></div>
      <h3>{project.name}</h3>
      <p class="project-summary">{project.summary}</p>
      {!compact && <p class="project-detail">{project.detail}</p>}
      {!compact && <div class="project-tags">{project.tags.map(tag => <span>{tag}</span>)}</div>}
      {!compact && project.note && <p class="project-note">{project.note}</p>}
      <a href={project.href} target="_blank" rel="noopener noreferrer" class="personal-text-link project-link" aria-label={`${project.name}：${project.linkLabel}（新しいタブ）`}>
        {project.linkLabel} <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>
