---
import { render } from "astro:content";
import Avatar from "../../components/Avatar.astro";
import Icon from "../../components/Icon.astro";
import PostGrid from "../../components/PostGrid.astro";
import { person } from "../../data/profile";
import Base from "../../layouts/Base.astro";
import { type Post, getPosts, jpDate, tagUrl } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3),
		},
	}));
}
const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content } = await render(post);
const { title, description, published, updated, tags, note, image } = post.data;
---
<Base title={title} description={description} image={image || undefined} article>
	<main class="px-5 pt-16">
		<article class="mx-auto max-w-3xl">
			<div class="breadcrumbs text-sm text-base-content/60"><ul><li><a href="/">ホーム</a></li><li><a href="/posts/">記事</a></li><li class="truncate">本文</li></ul></div>
			<h1 class="mt-3 text-2xl leading-snug font-bold sm:text-3xl">{title}</h1>
			<div class="mt-6 flex items-center gap-3">
				<Avatar size={40} />
				<div class="leading-tight">
					<p class="text-sm font-bold">{person.name}</p>
					<p class="text-xs text-base-content/60">
						<time datetime={published.toISOString()}>{jpDate(published)}</time>
						{updated && <span>（更新 {jpDate(updated)}）</span>}
					</p>
				</div>
			</div>
			{tags.length > 0 && (
				<div class="mt-5 flex flex-wrap gap-2">
					{tags.map((t) => <a href={tagUrl(t)} class="badge badge-outline badge-md border-base-content/20 hover:border-primary">{t}</a>)}
				</div>
			)}
			{note && (
				<div role="note" class="alert alert-soft alert-info mt-8 text-sm">
					<Icon name="info" class="size-5 shrink-0" />
					<span>{note}</span>
				</div>
			)}
			<div class="prose article-body mt-8 max-w-none"><Content /></div>

			<div class="card mt-16 bg-base-200">
				<div class="card-body flex-row items-center gap-4 p-5">
					<Avatar size={56} />
					<div class="min-w-0">
						<p class="font-bold">{person.name}</p>
						<p class="text-sm text-base-content/70">{person.bio.join("")}</p>
					</div>
					<a href="/" class="btn btn-sm ms-auto shrink-0 border-0 bg-base-300">プロフィール</a>
				</div>
			</div>
		</article>

		{related.length > 0 && (
			<section class="mx-auto mt-16 max-w-6xl" aria-labelledby="h-related">
				<h2 id="h-related" class="text-xl font-bold">ほかの記事</h2>
				<div class="mt-5"><PostGrid posts={related} /></div>
			</section>
		)}
	</main>
</Base>
