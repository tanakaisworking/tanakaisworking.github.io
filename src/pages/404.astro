---
import Base from "../layouts/Base.astro";
---
<Base title="ページが見つかりません">
	<main class="mx-auto flex max-w-xl flex-col items-center px-5 pt-32 text-center">
		<p class="text-6xl font-bold text-base-content/30">404</p>
		<h1 class="mt-4 text-xl font-bold">ページが見つかりません</h1>
		<p class="mt-2 text-base-content/70">移動したか、削除された可能性があります。</p>
		<div class="mt-8 flex gap-3">
			<a href="/" class="btn border-0 bg-base-300">ホームへ</a>
			<a href="/posts/" class="btn btn-ghost">記事一覧</a>
		</div>
	</main>
</Base>
