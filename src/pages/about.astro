---
import { getEntry, render } from 'astro:content';
import Markdown from '../components/misc/Markdown.astro';
import MainGridLayout from '../layouts/MainGridLayout.astro';
const aboutPost = await getEntry('spec', 'about');
if (!aboutPost) throw new Error('プロフィールの本文がありません');
const { Content, headings } = await render(aboutPost);
---
<MainGridLayout title="プロフィール" description="田中貴士。ヒバチ株式会社代表。AIとプロダクト開発、MCPを使ったツールづくりに取り組んでいます。" headings={headings}>
  <article class="card-base personal-article" data-pagefind-body>
    <Markdown class="mt-2"><Content /></Markdown>
  </article>
</MainGridLayout>
